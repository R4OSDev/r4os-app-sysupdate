R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=SYSUPD
VERSION=0.1.10
LANGUAGE=Zig
SOURCE=src/main.zig
ZIG_MODULE=system_update_engine:../../SDK/r4os/system_update_engine.zig
ENTRY_MODE=app
APP_CLASS=console
TARGET=/R4OS/SOFTWARE/TERMINAL/SYSUPD.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query:1
IMPORT=R4DEV:Query:1
META=role=system-updater
META=stage=apply
META=feature=bounded-update-io-retry
META=feature=bounded-stage-abort-retry
